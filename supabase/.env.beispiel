# Vorlage. Kopieren nach supabase/.env und die echten Werte eintragen.
# supabase/.env ist in .gitignore und landet nie im Repo.
#
# Discogs: https://www.discogs.com/settings/developers -> "Generate new token"
DISCOGS_TOKEN=
# Gemini, für die Cover-Bilderkennung: https://aistudio.google.com/apikey
# Schlüssel mit Präfix AQ. sind AI-Studio-Schlüssel und funktionieren hier;
# die Cloud-APIs (vision.googleapis.com) nehmen sie NICHT an.
GEMINI_API_KEY=

# Nur für Deploys: Personal Access Token des Kontos, dem das Projekt
# gehört. https://supabase.com/dashboard/account/tokens
# Nötig, weil `supabase login` ohne TTY abbricht.
SUPABASE_ACCESS_TOKEN=

# --- In-App-Kauf (Edge Function abo-pruefen) ---
# Apple: App Store Connect -> Benutzer und Zugriff -> Integrationen ->
# In-App-Kauf. Der Schlüssel wird EINMAL als .p8 heruntergeladen.
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
# Google: Dienstkonto mit Zugriff auf die Play Developer API, die
# heruntergeladene JSON-Datei komplett als eine Zeile.
GOOGLE_PLAY_SERVICE_ACCOUNT=
