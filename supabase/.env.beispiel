# Vorlage. Kopieren nach supabase/.env und die echten Werte eintragen.
# supabase/.env ist in .gitignore und landet nie im Repo.
#
# Discogs: https://www.discogs.com/settings/developers -> "Generate new token"
DISCOGS_TOKEN=
# Google Cloud Vision: Konsole -> APIs & Dienste -> Anmeldedaten.
# Die Cloud Vision API muss im Projekt aktiviert sein, und der Schlüssel
# sollte auf genau diese eine API eingeschränkt werden.
GOOGLE_VISION_KEY=
