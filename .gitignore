node_modules/
dist/
.DS_Store
.env
.env.local
supabase/.env          # Schlüssel für die Edge Functions
*.log

# Von tesseract.js im Arbeitsverzeichnis abgelegte Kopien der
# Sprachdaten. Die gepflegten liegen in app/vendor/tessdata/.
/*.traineddata

# Capacitor: aus app/ + wireframes/ gebaut, nicht von Hand gepflegt.
# Alles unter ios/ regelt ios/.gitignore selbst.
www/

# Supabase-CLI: Arbeitsstand der Verknüpfung, wird beim Deploy angelegt.
supabase/.temp/

# Android Studio / IntelliJ – Arbeitsplatz-Kram, gehoert niemandem sonst
android/.idea/

# web/deploy: lokales wrangler-Deploy-Projekt für collectview-site.
# assets/ ist nur eine Kopie von app/ + wireframes/ + generierter
# index.html fürs Deployen selbst - nicht committen, sonst dupliziert
# sich das im Repo. wrangler.toml + worker.js gehören ins Repo.
web/deploy/assets/*
# ...außer die beiden SEO-Dateien: die haben kein Gegenstück in app/ oder
# wireframes/, aus dem sie generiert werden könnten, sind also selbst die
# Quelle (siehe web/deploy/assets/robots.txt, sitemap.xml). "assets/*" statt
# "assets/" ist hier nötig, sonst blockt Git das Verzeichnis komplett und
# die Ausnahmen unten greifen gar nicht erst.
!web/deploy/assets/robots.txt
!web/deploy/assets/sitemap.xml

# wrangler: lokaler Build-Cache beim Deploy, keine Quelle.
web/deploy/.wrangler/
